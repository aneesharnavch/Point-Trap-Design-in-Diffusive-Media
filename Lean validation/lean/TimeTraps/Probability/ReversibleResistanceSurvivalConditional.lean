module

public import TimeTraps.Probability.ReversibleResistanceSurvival
public import TimeTraps.Probability.ExponentialKillingConditionalExpectation

@[expose] public section

/-! Conditional survival for the actual first-attainment lifetime, given
the entire driving path coordinate. This sigma-algebra is explicit; this
file does not identify it with the sigma-algebra generated by the physical
diffusion path. -/

namespace TimeTraps.Probability

open Set MeasureTheory ProbabilityTheory Filter TimeTraps.Interval
open scoped NNReal ENNReal

variable {ι : Type*} [Fintype ι]

theorem reversibleResistanceAttainmentLifetime_indicator_ae (A : IntervalMedium) (x : ℝ)
    (a κ : ι → ℝ) (hκ : ∀ i, 0 ≤ κ i) (t : ℝ) (ht : 0 ≤ t) :
    ({p | (t : WithTop ℝ) < reversibleResistanceAttainmentLifetime A x a κ p}.indicator
      (fun _ => (1 : ℝ))) =ᵐ[exponentialKillingMeasure brownianDyadicMeasure]
      (exponentialSurvivalEvent (reversibleResistanceAtomicClock A x a κ t)).indicator
        (fun _ => (1 : ℝ)) := by
  filter_upwards [reversibleResistanceAttainmentLifetime_survival_iff_ae A x a κ hκ t ht] with p hp
  simp only [Set.indicator_apply, mem_ofPred_eq, exponentialSurvivalEvent, hp]

theorem reversibleResistanceAttainmentLifetime_indicator_integrable (A : IntervalMedium) (x : ℝ)
    (a κ : ι → ℝ) (hκ : ∀ i, 0 ≤ κ i) (t : ℝ) (ht : 0 ≤ t) :
    Integrable ({p | (t : WithTop ℝ) < reversibleResistanceAttainmentLifetime A x a κ p}.indicator
      (fun _ => (1 : ℝ))) (exponentialKillingMeasure brownianDyadicMeasure) :=
  (exponentialKilling_survival_indicator_integrable brownianDyadicMeasure
    (reversibleResistanceAtomicClock A x a κ t)
    (reversibleResistanceAtomicClock_measurable A x a κ t)).congr
      (reversibleResistanceAttainmentLifetime_indicator_ae A x a κ hκ t ht).symm

theorem reversibleResistanceAttainmentLifetime_condExp (A : IntervalMedium) (x : ℝ)
    (a κ : ι → ℝ) (hκ : ∀ i, 0 ≤ κ i) (t : ℝ) (ht : 0 ≤ t) :
    (exponentialKillingMeasure brownianDyadicMeasure)[
      {p | (t : WithTop ℝ) < reversibleResistanceAttainmentLifetime A x a κ p}.indicator
        (fun _ => (1 : ℝ)) |
      (inferInstance : MeasurableSpace (ℕ → ℝ)).comap (Prod.fst : (ℕ → ℝ) × ℝ → (ℕ → ℝ))]
      =ᵐ[exponentialKillingMeasure brownianDyadicMeasure]
        (fun p => reversibleResistanceAtomicSurvival A x a κ t.toNNReal p.1) :=
  (condExp_congr_ae (reversibleResistanceAttainmentLifetime_indicator_ae A x a κ hκ t ht)).trans
    (exponentialKilling_survival_condExp brownianDyadicMeasure
      (reversibleResistanceAtomicClock A x a κ t)
      (reversibleResistanceAtomicClock_measurable A x a κ t)
      (fun ω => reversibleResistanceAtomicHazard_nonneg A x a κ hκ t.toNNReal ω))

end TimeTraps.Probability
