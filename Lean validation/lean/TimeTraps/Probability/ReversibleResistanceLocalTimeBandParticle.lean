module

public import TimeTraps.Probability.ReversibleResistanceLocalTimeBandData

@[expose] public section

/-! The sigma-algebra generated by the actual physical particle path.
Continuity upgrades its measurable time evaluations to joint measurability,
so each genuine occupation band is measurable in this smaller sigma-algebra. -/

namespace TimeTraps.Probability

open Set MeasureTheory Filter TimeTraps.Analysis TimeTraps.Interval
open scoped NNReal Topology

@[instance_reducible] noncomputable def reversibleResistanceParticleSigma (A : IntervalMedium) (x : ℝ) :
    MeasurableSpace (ℕ → ℝ) :=
  (inferInstance : MeasurableSpace (ℝ≥0 → ℝ)).comap (fun ω t => reversibleResistancePath A x t ω)

theorem reversibleResistanceParticleSigma_le (A : IntervalMedium) (x : ℝ) :
    reversibleResistanceParticleSigma A x ≤ (inferInstance : MeasurableSpace (ℕ → ℝ)) := by
  apply Measurable.comap_le
  apply measurable_pi_lambda
  intro t
  let q : (ℕ → ℝ) → ℝ≥0 × (ℕ → ℝ) := fun ω => (t, ω)
  have hq : Measurable q := measurable_const.prodMk measurable_id
  have hm := (reversibleResistancePath_jointlyMeasurable A x).comp hq
  dsimp only [Function.comp_def, q] at hm
  exact hm

theorem reversibleResistancePath_particle_measurable (A : IntervalMedium) (x : ℝ) (t : ℝ≥0) :
    Measurable[reversibleResistanceParticleSigma A x] (reversibleResistancePath A x t) :=
  (measurable_pi_apply t).comp (comap_measurable (fun ω s => reversibleResistancePath A x s ω))

theorem reversibleResistancePath_particle_jointlyMeasurable (A : IntervalMedium) (x : ℝ) :
    @Measurable (ℝ≥0 × (ℕ → ℝ)) ℝ
      ((inferInstance : MeasurableSpace ℝ≥0).prod (reversibleResistanceParticleSigma A x)) inferInstance
      (fun p => reversibleResistancePath A x p.1 p.2) := by
  let : MeasurableSpace (ℕ → ℝ) := reversibleResistanceParticleSigma A x
  exact measurable_uncurry_of_continuous_of_measurable (reversibleResistancePath_continuous A x)
    (reversibleResistancePath_particle_measurable A x)

theorem reversibleResistanceOccupationBand_particle_measurable (A : IntervalMedium) (x a h : ℝ) (T : ℝ≥0) :
    Measurable[reversibleResistanceParticleSigma A x] (reversibleResistanceOccupationBand A x a h T) := by
  let : MeasurableSpace (ℕ → ℝ) := reversibleResistanceParticleSigma A x
  exact measurable_const.mul (brownianItoDrift_bounded_measurable
    (reversibleResistanceBandTest_measurable A a h) (reversibleResistancePath_particle_jointlyMeasurable A x) T)

end TimeTraps.Probability
