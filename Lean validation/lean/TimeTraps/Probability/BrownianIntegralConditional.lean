module

public import TimeTraps.Probability.BrownianIntegralClosure

@[expose] public section

/-! Conditional mean zero on the actual closed subspace generated by
elementary adapted processes starting at or after a fixed time. The
conditioning sigma-algebra is the raw natural filtration. -/

noncomputable section

namespace TimeTraps.Probability

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal

variable {Ω : Type*} {mΩ : MeasurableSpace Ω}

def brownianIntegralFutureSpace (B : ℝ≥0 → Ω → ℝ)
    (hBm : ∀ t, Measurable (B t)) (P : Measure Ω) (t : ℝ≥0) :
    Submodule ℝ (brownianIntegralSpace B hBm P) :=
  (Submodule.span ℝ (Set.range (fun a : {a : BrownianIntegralElementary B hBm P // t ≤ a.left} =>
    brownianIntegralGenerator a.1))).topologicalClosure

variable {B : ℝ≥0 → Ω → ℝ} {hBm : ∀ t, Measurable (B t)} {P : Measure Ω}

def brownianIntegralCondExpL2 (hB : IsPreBrownianReal B P) (t : ℝ≥0) :
    brownianIntegralSpace B hBm P →L[ℝ] Lp ℝ 2 P :=
  (lpMeas ℝ ℝ (brownianNaturalFiltration B hBm t) 2 P).subtypeL.comp
    ((condExpL2 ℝ ℝ ((brownianNaturalFiltration B hBm).le t)).comp
      (brownianIntegral hB).toContinuousLinearMap)

theorem brownianIntegralCondExpL2_ae (hB : IsPreBrownianReal B P) (t : ℝ≥0)
    (f : brownianIntegralSpace B hBm P) :
    brownianIntegralCondExpL2 hB t f =ᵐ[P]
      P[brownianIntegral hB f | brownianNaturalFiltration B hBm t] := by
  have : IsProbabilityMeasure P := (hB.hasLaw_eval 0).isProbabilityMeasure
  change (condExpL2 ℝ ℝ ((brownianNaturalFiltration B hBm).le t)
    (brownianIntegral hB f) : Ω → ℝ) =ᵐ[P] _
  simpa only [Lp.toLp_coeFn] using (Lp.memLp (brownianIntegral hB f)).condExpL2_ae_eq_condExp
    (𝕜 := ℝ) ((brownianNaturalFiltration B hBm).le t)

theorem BrownianIntegralElementary.integralL2_condExp_future (hB : IsPreBrownianReal B P)
    (a : BrownianIntegralElementary B hBm P) {t : ℝ≥0} (ht : t ≤ a.left) :
    P[a.integralL2 hB | brownianNaturalFiltration B hBm t] =ᵐ[P] 0 := by
  have : IsProbabilityMeasure P := (hB.hasLaw_eval 0).isProbabilityMeasure
  have hl : P[a.integralL2 hB | brownianNaturalFiltration B hBm a.left] =ᵐ[P] 0 :=
    (condExp_congr_ae (a.integralL2_coe hB)).trans
      (brownian_weighted_increment_condExp hB hBm a.ordered a.adapted
        (a.squareIntegrable.integrable (by norm_num)))
  refine (condExp_condExp_of_le ((brownianNaturalFiltration B hBm).mono ht)
    ((brownianNaturalFiltration B hBm).le a.left)).symm.trans ?_
  exact (condExp_congr_ae hl).trans (by simp)

theorem brownianIntegralGenerator_mem_future (a : BrownianIntegralElementary B hBm P)
    {t : ℝ≥0} (ht : t ≤ a.left) :
    brownianIntegralGenerator a ∈ brownianIntegralFutureSpace B hBm P t :=
  Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨⟨a, ht⟩, rfl⟩)

/-- The conditional expectation vanishes on the closed future subspace. -/
theorem brownianIntegral_condExp_future (hB : IsPreBrownianReal B P) (t : ℝ≥0)
    (f : brownianIntegralSpace B hBm P) (hf : f ∈ brownianIntegralFutureSpace B hBm P t) :
    P[brownianIntegral hB f | brownianNaturalFiltration B hBm t] =ᵐ[P] 0 := by
  have hgen (a : BrownianIntegralElementary B hBm P) (ha : t ≤ a.left) :
      brownianIntegralCondExpL2 hB t (brownianIntegralGenerator a) = 0 := by
    apply Lp.ext
    refine (brownianIntegralCondExpL2_ae hB t (brownianIntegralGenerator a)).trans ?_
    rw [brownianIntegral_generator]
    exact (a.integralL2_condExp_future hB ha).trans (Lp.coeFn_zero ℝ 2 P).symm
  have hs : Submodule.span ℝ (Set.range
      (fun a : {a : BrownianIntegralElementary B hBm P // t ≤ a.left} =>
        brownianIntegralGenerator a.1)) ≤ (brownianIntegralCondExpL2 hB t).ker := by
    apply Submodule.span_le.mpr
    rintro _ ⟨a, rfl⟩
    exact hgen a.1 a.2
  have hz : brownianIntegralCondExpL2 hB t f = 0 :=
    Submodule.topologicalClosure_minimal _ hs (brownianIntegralCondExpL2 hB t).isClosed_ker hf
  refine (brownianIntegralCondExpL2_ae hB t f).symm.trans ?_
  rw [hz]
  exact Lp.coeFn_zero ℝ 2 P

end TimeTraps.Probability

end
