module

public import Mathlib.MeasureTheory.Constructions.Projective
public import Mathlib.MeasureTheory.Integral.Bochner.Set

@[expose] public section

/-! Equality of integrable observations on finite history cylinders
extends to the complete sigma algebra generated by that history. -/

namespace TimeTraps.Probability

open Set MeasureTheory

variable {Ω : Type*} [mΩ : MeasurableSpace Ω]

theorem setIntegral_eq_of_generating_piSystem (μ : Measure Ω)
    (m : MeasurableSpace Ω) (hm : m ≤ mΩ) (C : Set (Set Ω))
    (hgen : m = MeasurableSpace.generateFrom C) (hpi : IsPiSystem C)
    {f g : Ω → ℝ} (hf : Integrable f μ) (hg : Integrable g μ)
    (hu : (∫ ω, f ω ∂μ) = ∫ ω, g ω ∂μ)
    (hC : ∀ S ∈ C, (∫ ω in S, f ω ∂μ) = ∫ ω in S, g ω ∂μ)
    {S : Set Ω} (hS : MeasurableSet[m] S) :
    (∫ ω in S, f ω ∂μ) = ∫ ω in S, g ω ∂μ := by
  apply MeasurableSpace.induction_on_inter
    (m := m) (C := fun S _ => (∫ ω in S, f ω ∂μ) = ∫ ω in S, g ω ∂μ)
    hgen hpi (t := S) (ht := hS)
  · simp
  · exact hC
  · intro S hS he
    rw [setIntegral_compl (hm _ hS) hf, setIntegral_compl (hm _ hS) hg, hu, he]
  · intro S hd hS he
    rw [integral_iUnion (fun n => hm _ (hS n)) hd hf.integrableOn,
      integral_iUnion (fun n => hm _ (hS n)) hd hg.integrableOn]
    exact tsum_congr he

theorem setIntegral_eq_of_finite_history {ι α : Type*} [MeasurableSpace α]
    (μ : Measure Ω) (Y : Ω → (ι → α)) (hY : Measurable Y)
    {f g : Ω → ℝ} (hf : Integrable f μ) (hg : Integrable g μ)
    (hu : (∫ ω, f ω ∂μ) = ∫ ω, g ω ∂μ)
    (hC : ∀ (I : Finset ι) (S : Set (I → α)), MeasurableSet S →
      (∫ ω in Y ⁻¹' cylinder I S, f ω ∂μ) = ∫ ω in Y ⁻¹' cylinder I S, g ω ∂μ)
    {S : Set Ω} (hS : MeasurableSet[MeasurableSpace.comap Y inferInstance] S) :
    (∫ ω in S, f ω ∂μ) = ∫ ω in S, g ω ∂μ := by
  let C := Set.preimage Y '' measurableCylinders (fun _ : ι => α)
  have hg : MeasurableSpace.comap Y inferInstance = MeasurableSpace.generateFrom C := by
    rw [← generateFrom_measurableCylinders (α := fun _ : ι => α), MeasurableSpace.comap_generateFrom]
  have hp : IsPiSystem C := by
    exact (isPiSystem_measurableCylinders (α := fun _ : ι => α)).comap Y
  apply setIntegral_eq_of_generating_piSystem μ _ hY.comap_le C hg hp hf ‹Integrable g μ› hu ?_ hS
  rintro _ ⟨A, hA, rfl⟩
  obtain ⟨I, T, hT, rfl⟩ := (mem_measurableCylinders _).mp hA
  exact hC I T hT

end TimeTraps.Probability
