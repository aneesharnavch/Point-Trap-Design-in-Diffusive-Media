module

public import TimeTraps.Probability.MarkovFiniteKernelMap

@[expose] public section

/-! Finite observation deletion is generated by retaining a state,
merging two elapsed intervals when the intermediate state is removed,
and dropping all remaining observations. The resulting projected law is
proved equal to the coarser trajectory law, without a consistency premise. -/

namespace TimeTraps.Probability

open Set MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

inductive ElapsedObservationPruning : List ℝ≥0 → List ℝ≥0 → Type
  | empty (d : List ℝ≥0) : ElapsedObservationPruning d []
  | keep (t : ℝ≥0) {d e : List ℝ≥0} (p : ElapsedObservationPruning d e) :
      ElapsedObservationPruning (t :: d) (t :: e)
  | merge (s t : ℝ≥0) (d e : List ℝ≥0)
      (p : ElapsedObservationPruning ((s + t) :: d) e) :
      ElapsedObservationPruning (s :: t :: d) e
  | trans {d e f : List ℝ≥0} (p : ElapsedObservationPruning d e)
      (q : ElapsedObservationPruning e f) : ElapsedObservationPruning d f

variable {α : Type*} [MeasurableSpace α]

def ElapsedObservationPruning.stateMap {d e : List ℝ≥0}
    (p : ElapsedObservationPruning d e) : (Fin d.length → α) → (Fin e.length → α) :=
  match p with
  | .empty _ => fun _ => Fin.elim0
  | .keep _ q => finiteStateLift q.stateMap
  | .merge _ _ _ _ q => q.stateMap ∘ Fin.tail
  | .trans p q => q.stateMap ∘ p.stateMap

theorem ElapsedObservationPruning.stateMap_measurable {d e : List ℝ≥0}
    (p : ElapsedObservationPruning d e) : Measurable (p.stateMap (α := α)) := by
  induction p with
  | empty _ => exact measurable_const
  | keep _ _ ih => exact finiteStateLift_measurable ih
  | merge _ _ d _ _ ih => exact ih.comp (finiteStateTail_measurable (d.length + 1))
  | trans p q hp hq => exact hq.comp hp

theorem ElapsedObservationPruning.kernel_consistency
    (K : ℝ≥0 → Kernel α α) [∀ t, IsMarkovKernel (K t)]
    (hadd : ∀ s t, K (s + t) = K t ∘ₖ K s)
    {d e : List ℝ≥0} (p : ElapsedObservationPruning d e) :
    (finiteMarkovKernel K d).map p.stateMap = finiteMarkovKernel K e := by
  induction p with
  | empty d => exact finiteMarkovKernel_map_empty K d
  | keep t p ih =>
    change (finiteMarkovKernel K (t :: _)).map (finiteStateLift p.stateMap) = _
    rw [finiteMarkovKernel_map_lift K t _ p.stateMap_measurable, ih]
    rfl
  | merge s t d e p ih =>
    change (finiteMarkovKernel K (s :: t :: d)).map (p.stateMap ∘ Fin.tail) = _
    rw [Kernel.map_comp_right _ (finiteStateTail_measurable (d.length + 1)) p.stateMap_measurable,
      finiteMarkovKernel_merge_first K hadd s t d, ih]
  | trans p q hp hq =>
    change (finiteMarkovKernel K _).map (q.stateMap ∘ p.stateMap) = _
    rw [Kernel.map_comp_right _ p.stateMap_measurable q.stateMap_measurable, hp, hq]

end TimeTraps.Probability
