module

public import TimeTraps
public meta import Lean.Util.CollectAxioms
public meta import Lean.Elab.Command

public meta section

open Lean Elab Command

/-- Audit every imported declaration in the project's public namespace. -/
elab "audit_time_traps" : command => do
  let env ← getEnv
  let allowed : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  let mut count : Nat := 0
  for (name, _) in env.constants do
    if (`TimeTraps).isPrefixOf name then
      count := count + 1
      let axioms ← collectAxioms name
      for ax in axioms do
        unless allowed.contains ax do
          throwError "Unapproved axiom dependency in {name}: {ax}"
      logInfo m!"AUDITED {name}: {axioms}"
  if count == 0 then
    throwError "No TimeTraps declarations were found"
  logInfo m!"PASS: audited {count} TimeTraps declarations"

audit_time_traps

